  "format": {
    "packs": {
      "en": {
        "popup.greeting": "Hello {name} in {app}",
        "popup.braces": "{{{name}}} {{plain}}",
        "popup.only_en": "Fallback {name}",
        "mailbox.unread_one": "{n} unread letter",
        "mailbox.unread_other": "{n} unread letters"
      },
      "zh-Hans": {
        "popup.greeting": "{name} 在 {app}",
        "popup.braces": "{{{name}}} {{plain}}",
        "mailbox.unread_one": "{n} 封未读",
        "mailbox.unread_other": "{n} 封未读"
      },
      "zh-Hant": {
        "popup.greeting": "{name} 在 {app}",
        "popup.braces": "{{{name}}} {{plain}}",
        "mailbox.unread_one": "{n} 封未讀",
        "mailbox.unread_other": "{n} 封未讀"
      }
    },
    "cases": [
      {
        "tag": "en",
        "key": "popup.greeting",
        "args": {
          "name": "Muse",
          "app": "Mail"
        },
        "expected": "Hello Muse in Mail"
      },
      {
        "tag": "zh-Hans",
        "key": "popup.greeting",
        "args": {
          "name": "Muse",
          "app": "Mail"
        },
        "expected": "Muse 在 Mail"
      },
      {
        "tag": "en",
        "key": "popup.braces",
        "args": {
          "name": "{Muse}"
        },
        "expected": "{{Muse}} {plain}"
      },
      {
        "tag": "zh-Hant",
        "key": "popup.only_en",
        "args": {
          "name": "Muse"
        },
        "expected": "Fallback Muse"
      },
      {
        "tag": "en",
        "key": "popup.missing",
        "args": {},
        "expected": "popup.missing"
      },
      {
        "tag": "en",
        "key": "mailbox.unread",
        "n": 1,
        "args": {},
        "expected": "1 unread letter"
      },
      {
        "tag": "en",
        "key": "mailbox.unread",
        "n": 2,
        "args": {},
        "expected": "2 unread letters"
      },
      {
        "tag": "zh-Hans",
        "key": "mailbox.unread",
        "n": 1,
        "args": {},
        "expected": "1 封未读"
      },
      {
        "tag": "zh-Hans",
        "key": "mailbox.unread",
        "n": 2,
        "args": {},
        "expected": "2 封未读"
      },
      {
        "tag": "zh-Hant",
        "key": "mailbox.unread",
        "n": 1,
        "args": {},
        "expected": "1 封未讀"
      },
      {
        "tag": "zh-Hant",
        "key": "mailbox.unread",
        "n": 2,
