{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "muselink/experience-entry/1",
  "title": "MuseLink experience entry (docs/architecture.en.md section 10)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema", "app", "goal", "method", "verify", "status", "created", "last_verified", "works", "fails", "source"],
  "properties": {
    "id": { "type": "string", "pattern": "^x-[0-9a-f]{12}$" },
    "schema": { "const": 1 },
    "app": { "type": "string", "minLength": 1, "maxLength": 80 },
    "app_version": { "type": "string", "maxLength": 40 },
    "ui": { "type": "string", "maxLength": 160 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 160 },
    "method": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1, "maxLength": 160 },
          {
            "type": "object", "additionalProperties": false, "required": ["step"],
            "properties": {
              "step": { "type": "string", "minLength": 1, "maxLength": 160 },
              "tool": { "type": "string", "pattern": "^[a-z_]{2,32}$" },
              "args": { "type": "object" }
            }
          }
        ]
      }
    },
    "verify": { "type": "string", "minLength": 1, "maxLength": 240 },
    "status": { "enum": ["draft", "valid", "review", "stale"] },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "works": { "type": "integer", "minimum": 0 },
    "fails": { "type": "integer", "minimum": 0 },
    "source": { "enum": ["local", "public"] },
    "agent": { "type": "string", "maxLength": 32 },
    "tags": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 24 } }
  }
}
