# muse-bridge.service - template, rendered only by bridge/render-unit.sh
# (installer and self-heal hook), which fills __USER__, __VM_DIR__, __HOME__
# and __CONFIG__; the result goes to /etc/systemd/system/.
# MUSELINK_HOME / MUSELINK_CONFIG: systemd starts the service with the passwd
# home of User=, which need not hold .config/muselink/muselink.env; without
# them lib/muselink-common.sh finds no config and the service exits at once.
# The Muse guest boots default.target (not multi-user.target), so the unit is
# wanted by default.target. Runs as the agent user, never as root.
[Unit]
Description=MuseLink bridge: resident release pipeline + stall watchdog
After=network.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=__USER__
Environment="MUSELINK_HOME=__HOME__"
Environment="MUSELINK_CONFIG=__CONFIG__"
ExecStart=__VM_DIR__/bridge/bridge-service.sh
WorkingDirectory=__VM_DIR__
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=default.target
